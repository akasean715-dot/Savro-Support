PORT=3010
NODE_ENV=development
# Use a SEPARATE support database/schema, never Savro's existing app tables.
DB_HOST=your-mysql-host
DB_PORT=25090
DB_USER=your-support-db-user
DB_PASSWORD=replace-me
DB_NAME=savro_support
DB_SSL=true
ADMIN_NAME=Savro Support Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-long-unique-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
